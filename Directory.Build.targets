<Project>
  <PropertyGroup Condition="'$(CombinedSampleBrowser)' == 'true' And '$(MSBuildProjectName)' != 'SampleBrowser.Maui.Combined'">
    <OutputType>Library</OutputType>
    <!--
      The sample projects are executables in their own csproj, so the SDK still
      wants a runtimeconfig.json. After they become libraries, that file is not
      packaged, and the RID output directory it writes into does not exist.
    -->
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>
  <!--
    Sample manifests are app packages. Several omit Identity Name, so MSIX
    validation fails once the project is a library. The host is the only app.
  -->
  <PropertyGroup Condition="'$(CombinedSampleBrowser)' == 'true' And '$(MSBuildProjectName)' != 'SampleBrowser.Maui.Combined' And '$(TargetPlatformIdentifier)' == 'windows'">
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <AppxPackage>false</AppxPackage>
  </PropertyGroup>
  <!--
    Release uses XamlC, which cannot resolve Syncfusion.Maui.Core.LegendItem
    through the shared maui XML namespace. These three samples are the ones
    that hit that. Runtime inflation skips that compile step. SourceGen compiles
    the XAML but then fails nullable event-handler warnings as errors.
  -->
  <PropertyGroup Condition="'$(CombinedSampleBrowser)' == 'true' And ('$(MSBuildProjectName)' == 'SampleBrowser.Maui.FunnelChart' Or '$(MSBuildProjectName)' == 'SampleBrowser.Maui.PolarChart' Or '$(MSBuildProjectName)' == 'SampleBrowser.Maui.PyramidChart')">
    <MauiXamlInflator>Runtime</MauiXamlInflator>
    <NoWarn>$(NoWarn);MAUI1001</NoWarn>
  </PropertyGroup>

  <!--
    Library mode for samples referenced by the combined host. See
    openspec/changes/combined-demo-app/design.md, "Combined-build fixes".
    App.xaml stays: samples call App.Current. AppDelegate is removed so every
    sample does not register the native name AppDelegate. iOS Resources is
    removed because that directory name is illegal in a MAUI library.
    Icons and splash screens are removed so the host keeps its own icon.
    Sample manifests still name mipmap/appicon, so Android library builds
    use a copy in obj/ with those attributes removed.
  -->
  <ItemGroup Condition="'$(CombinedSampleBrowser)' == 'true' And '$(MSBuildProjectName)' != 'SampleBrowser.Maui.Combined'">
    <Compile Remove="MauiProgram.cs" />
    <Compile Remove="Platforms\Android\MainActivity.cs" />
    <Compile Remove="Platforms\Android\MainApplication.cs" />
    <Compile Remove="Platforms\iOS\AppDelegate.cs" />
    <Compile Remove="Platforms\iOS\Program.cs" />
    <Compile Remove="Platforms\MacCatalyst\AppDelegate.cs" />
    <Compile Remove="Platforms\MacCatalyst\Program.cs" />
    <Compile Remove="Platforms\Tizen\Main.cs" />
    <Compile Remove="Platforms\Windows\App.xaml.cs" />
    <MauiIcon Remove="@(MauiIcon)" />
    <MauiSplashScreen Remove="@(MauiSplashScreen)" />
    <BundleResource Remove="Platforms\iOS\Resources\**" />
    <InterfaceDefinition Remove="Platforms\iOS\Resources\**" />
    <Content Remove="Platforms\iOS\Resources\**" />
    <None Remove="Platforms\iOS\Resources\**" />
    <EmbeddedResource Remove="Platforms\iOS\Resources\**" />
    <MauiXaml Remove="Platforms\Windows\App.xaml" />
    <None Remove="Platforms\Windows\App.xaml" />
    <ApplicationDefinition Remove="Platforms\Windows\App.xaml" />
    <AppxManifest Remove="@(AppxManifest)" Condition="'$(TargetPlatformIdentifier)' == 'windows'" />
    <CustomAppxManifest Remove="@(CustomAppxManifest)" Condition="'$(TargetPlatformIdentifier)' == 'windows'" />
    <Manifest Remove="@(Manifest)" Condition="'$(TargetPlatformIdentifier)' == 'windows'" />
    <None Remove="Platforms\Windows\Package.appxmanifest" Condition="'$(TargetPlatformIdentifier)' == 'windows'" />
    <None Remove="Platforms\Windows\app.manifest" Condition="'$(TargetPlatformIdentifier)' == 'windows'" />
    <Content Remove="Platforms\Windows\Package.appxmanifest" Condition="'$(TargetPlatformIdentifier)' == 'windows'" />
    <Content Remove="Platforms\Windows\app.manifest" Condition="'$(TargetPlatformIdentifier)' == 'windows'" />
  </ItemGroup>

  <!--
    Globs and the Windows App SDK add the package manifest after the item group
    above. Drop it again immediately before MSIX validation.
  -->
  <Target Name="DropCombinedWindowsPackage"
          BeforeTargets="_ValidatePresenceOfAppxManifestItems;_ValidateWindowsPackageType"
          Condition="'$(CombinedSampleBrowser)' == 'true' And '$(MSBuildProjectName)' != 'SampleBrowser.Maui.Combined' And '$(TargetPlatformIdentifier)' == 'windows'">
    <ItemGroup>
      <AppxManifest Remove="@(AppxManifest)" />
      <CustomAppxManifest Remove="@(CustomAppxManifest)" />
      <Manifest Remove="@(Manifest)" />
    </ItemGroup>
    <PropertyGroup>
      <WindowsPackageType>None</WindowsPackageType>
      <AppxPackage>false</AppxPackage>
      <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    </PropertyGroup>
  </Target>

  <!--
    Quick Look helpers are copied into several sample projects under the same class names.
    iOS registers those names globally, so the combined app rewrites the copies in obj/
    and leaves the upstream files untouched.
  -->
  <UsingTask TaskName="PrefixRegistrarNames" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Prefix ParameterType="System.String" Required="true" />
      <OutputDirectory ParameterType="System.String" Required="true" />
      <Outputs ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var results = new List<Microsoft.Build.Framework.ITaskItem>();
        Directory.CreateDirectory(OutputDirectory);
        string[] classes = { "PreviewControllerDS", "QLPreviewItemFileSystem", "QLPreviewItemBundle" };
        foreach (var file in Files)
        {
          var text = File.ReadAllText(file.ItemSpec);
          var changed = false;
          foreach (var cls in classes)
          {
            var needle = "public class " + cls + " ";
            var attribute = "[Foundation.Register(\"" + Prefix + cls + "\")]\n";
            if (text.Contains(needle) && !text.Contains(attribute.Trim()))
            {
              text = text.Replace(needle, attribute + needle);
              changed = true;
            }
          }
          if (!changed)
          {
            continue;
          }
          var destination = Path.Combine(OutputDirectory, Path.GetFileName(file.ItemSpec));
          File.WriteAllText(destination, text);
          results.Add(new Microsoft.Build.Utilities.TaskItem(destination));
        }
        Outputs = results.ToArray();
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="PrefixQuickLookNativeNames"
          BeforeTargets="CoreCompile"
          Condition="'$(CombinedSampleBrowser)' == 'true' And '$(MSBuildProjectName)' != 'SampleBrowser.Maui.Combined'">
    <ItemGroup>
      <_QuickLookSource Include="Platforms\iOS\PreviewControllerDS.cs" Condition="'$(TargetPlatformIdentifier)' == 'ios' and Exists('Platforms\iOS\PreviewControllerDS.cs')" />
      <_QuickLookSource Include="Platforms\iOS\QLPreviewItemFileSystem.cs" Condition="'$(TargetPlatformIdentifier)' == 'ios' and Exists('Platforms\iOS\QLPreviewItemFileSystem.cs')" />
      <_QuickLookSource Include="Platforms\MacCatalyst\SaveMac.cs" Condition="'$(TargetPlatformIdentifier)' == 'maccatalyst' and Exists('Platforms\MacCatalyst\SaveMac.cs')" />
    </ItemGroup>
    <PrefixRegistrarNames
        Files="@(_QuickLookSource)"
        Prefix="$([System.String]::Copy('$(MSBuildProjectName)').Replace('SampleBrowser.Maui.', ''))"
        OutputDirectory="$(IntermediateOutputPath)quicklook/"
        Condition="'@(_QuickLookSource)' != ''">
      <Output TaskParameter="Outputs" ItemName="_QuickLookGenerated" />
    </PrefixRegistrarNames>
    <ItemGroup Condition="'@(_QuickLookGenerated)' != ''">
      <Compile Remove="@(_QuickLookSource)" />
      <Compile Include="@(_QuickLookGenerated)" />
    </ItemGroup>
  </Target>

  <!--
    Dropping MauiIcon leaves @mipmap/appicon in the sample AndroidManifest.
    aapt then fails the library build. Rewrite a copy under obj/ and leave
    the upstream manifest unchanged.
  -->
  <Target Name="StripCombinedLibraryLauncherIcon"
          BeforeTargets="_GetAndroidPackageName"
          Condition="'$(CombinedSampleBrowser)' == 'true' And '$(MSBuildProjectName)' != 'SampleBrowser.Maui.Combined' And '$(TargetPlatformIdentifier)' == 'android' And '$(AndroidManifest)' != '' And Exists('$(MSBuildProjectDirectory)/$(AndroidManifest)')">
    <PropertyGroup>
      <_StrippedAndroidManifest>$(IntermediateOutputPath)combined-android-manifest.xml</_StrippedAndroidManifest>
      <_StripAndroidIconScript>$(IntermediateOutputPath)strip-android-icon.py</_StripAndroidIconScript>
    </PropertyGroup>
    <WriteLinesToFile File="$(_StripAndroidIconScript)" Overwrite="true" Lines="import pathlib, re, sys; src, dst = sys.argv[1], sys.argv[2]; text = pathlib.Path(src).read_text(encoding='utf-8'); text = re.sub(' android:icon=&quot;[^&quot;]*&quot;', '', text); text = re.sub(' android:roundIcon=&quot;[^&quot;]*&quot;', '', text); path = pathlib.Path(dst); path.parent.mkdir(parents=True, exist_ok=True); path.write_text(text, encoding='utf-8')" />
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/$(_StripAndroidIconScript)&quot; &quot;$(MSBuildProjectDirectory)/$(AndroidManifest)&quot; &quot;$(MSBuildProjectDirectory)/$(_StrippedAndroidManifest)&quot;" />
    <PropertyGroup>
      <AndroidManifest>$(_StrippedAndroidManifest)</AndroidManifest>
    </PropertyGroup>
  </Target>

  <!--
    The Android app's per-RID build reenters every project with
    AppendRuntimeIdentifierToOutputPath=true and SkipCompilerExecution=true.
    Those are global properties, so the sample still compiles to
    obj/Debug/net10.0-android/ while the app links the copy under android-arm64/.
    Put the assembly that was already compiled in both of those places.
  -->
  <Target Name="SupplyCombinedAndroidLibraryAssembly"
          BeforeTargets="CopyFilesToOutputDirectory;_GetAssemblyInfoFromTemplateFile"
          Condition="'$(CombinedSampleBrowser)' == 'true' And '$(MSBuildProjectName)' != 'SampleBrowser.Maui.Combined' And '$(TargetPlatformIdentifier)' == 'android' And '$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <_CombinedLibraryAssemblySource>$(MSBuildProjectDirectory)/obj/$(Configuration)/$(TargetFramework)/$(TargetName)$(TargetExt)</_CombinedLibraryAssemblySource>
      <_CombinedLibraryAssembly>$(IntermediateOutputPath)$(TargetName)$(TargetExt)</_CombinedLibraryAssembly>
      <_CombinedLibraryPdbSource>$(MSBuildProjectDirectory)/obj/$(Configuration)/$(TargetFramework)/$(TargetName).pdb</_CombinedLibraryPdbSource>
      <_CombinedLibraryPdb>$(IntermediateOutputPath)$(TargetName).pdb</_CombinedLibraryPdb>
      <_CombinedLibraryBin>$(MSBuildProjectDirectory)/bin/$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)/$(TargetName)$(TargetExt)</_CombinedLibraryBin>
      <_CombinedLibraryBinPdb>$(MSBuildProjectDirectory)/bin/$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)/$(TargetName).pdb</_CombinedLibraryBinPdb>
    </PropertyGroup>
    <Copy SourceFiles="$(_CombinedLibraryAssemblySource)"
          DestinationFiles="$(_CombinedLibraryAssembly)"
          SkipUnchangedFiles="true"
          Condition="!Exists('$(_CombinedLibraryAssembly)') And Exists('$(_CombinedLibraryAssemblySource)')" />
    <Copy SourceFiles="$(_CombinedLibraryPdbSource)"
          DestinationFiles="$(_CombinedLibraryPdb)"
          SkipUnchangedFiles="true"
          Condition="!Exists('$(_CombinedLibraryPdb)') And Exists('$(_CombinedLibraryPdbSource)')" />
    <Copy SourceFiles="$(_CombinedLibraryAssemblySource)"
          DestinationFiles="$(_CombinedLibraryBin)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_CombinedLibraryAssemblySource)')" />
    <Copy SourceFiles="$(_CombinedLibraryPdbSource)"
          DestinationFiles="$(_CombinedLibraryBinPdb)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_CombinedLibraryPdbSource)')" />
  </Target>

  <!--
    Android's per-architecture build has to enter each sample: that pass does not
    compile, it copies the library that was already built. Other platforms compile
    once, into bin/$(Configuration)/$(TargetFramework)/[$(RuntimeIdentifier)/].
    A sample whose library is already there, and newer than its sources and these
    Directory.Build files, is referenced in place. Pass -p:CombinedBuildAllSamples=true
    to build every sample anyway.
  -->
  <UsingTask TaskName="FindFreshCombinedSamples" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Projects ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <ProjectDirectory ParameterType="System.String" Required="true" />
      <Configuration ParameterType="System.String" Required="true" />
      <TargetFramework ParameterType="System.String" Required="true" />
      <RuntimeIdentifier ParameterType="System.String" Required="false" />
      <SharedInputs ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="false" />
      <FreshProjects ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var fresh = new List<Microsoft.Build.Framework.ITaskItem>();
        foreach (var project in Projects)
        {
          var full = project.GetMetadata("FullPath");
          if (string.IsNullOrEmpty(full))
          {
            full = Path.GetFullPath(Path.Combine(ProjectDirectory, project.ItemSpec));
          }
          if (!File.Exists(full))
          {
            continue;
          }
          var projectDir = Path.GetDirectoryName(full);
          var assemblyName = Path.GetFileNameWithoutExtension(full);
          var outputDir = Path.Combine(projectDir, "bin", Configuration, TargetFramework);
          if (!string.IsNullOrEmpty(RuntimeIdentifier))
          {
            outputDir = Path.Combine(outputDir, RuntimeIdentifier);
          }
          var assemblyPath = Path.Combine(outputDir, assemblyName + ".dll");
          if (!File.Exists(assemblyPath))
          {
            continue;
          }
          var builtAt = File.GetLastWriteTimeUtc(assemblyPath);
          var dirty = false;
          if (SharedInputs != null)
          {
            foreach (var shared in SharedInputs)
            {
              if (File.Exists(shared.ItemSpec) && File.GetLastWriteTimeUtc(shared.ItemSpec) > builtAt)
              {
                dirty = true;
                break;
              }
            }
          }
          if (!dirty)
          {
            var pending = new Stack<string>();
            pending.Push(projectDir);
            while (pending.Count > 0 && !dirty)
            {
              var current = pending.Pop();
              foreach (var sub in Directory.EnumerateDirectories(current))
              {
                var name = Path.GetFileName(sub);
                if (name.Equals("bin", StringComparison.OrdinalIgnoreCase) || name.Equals("obj", StringComparison.OrdinalIgnoreCase) || name.Equals(".vs", StringComparison.OrdinalIgnoreCase) || name.Equals(".git", StringComparison.OrdinalIgnoreCase))
                {
                  continue;
                }
                pending.Push(sub);
              }
              foreach (var file in Directory.EnumerateFiles(current))
              {
                if (File.GetLastWriteTimeUtc(file) > builtAt)
                {
                  dirty = true;
                  break;
                }
              }
            }
          }
          if (dirty)
          {
            continue;
          }
          var item = new Microsoft.Build.Utilities.TaskItem(project.ItemSpec);
          item.SetMetadata("AssemblyName", assemblyName);
          item.SetMetadata("AssemblyPath", assemblyPath);
          fresh.Add(item);
        }
        FreshProjects = fresh.ToArray();
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="SkipFreshCombinedSamples"
          BeforeTargets="AssignProjectConfiguration"
          Condition="'$(CombinedSampleBrowser)' == 'true' And '$(MSBuildProjectName)' == 'SampleBrowser.Maui.Combined' And '$(BuildProjectReferences)' != 'false' And '$(CombinedBuildAllSamples)' != 'true' And '$(DesignTimeBuild)' != 'true' And '$(TargetFramework)' != '' And !$(TargetFramework.Contains('-android'))">
    <ItemGroup>
      <_CombinedSharedInput Include="$(MSBuildThisFileDirectory)Directory.Build.props" />
      <_CombinedSharedInput Include="$(MSBuildThisFileDirectory)Directory.Build.targets" />
    </ItemGroup>
    <FindFreshCombinedSamples
        Projects="@(ProjectReference)"
        ProjectDirectory="$(MSBuildProjectDirectory)"
        Configuration="$(Configuration)"
        TargetFramework="$(TargetFramework)"
        RuntimeIdentifier="$(RuntimeIdentifier)"
        SharedInputs="@(_CombinedSharedInput)">
      <Output TaskParameter="FreshProjects" ItemName="_FreshCombinedSample" />
    </FindFreshCombinedSamples>
    <ItemGroup Condition="'@(_FreshCombinedSample)' != ''">
      <ProjectReference Remove="@(_FreshCombinedSample)" />
      <ProjectReference Include="@(_FreshCombinedSample)">
        <BuildReference>false</BuildReference>
        <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
        <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
        <SetTargetFramework>TargetFramework=$(TargetFramework)</SetTargetFramework>
      </ProjectReference>
    </ItemGroup>
    <ItemGroup Condition="'@(_FreshCombinedSample)' != ''">
      <Reference Include="%(_FreshCombinedSample.AssemblyName)">
        <HintPath>%(_FreshCombinedSample.AssemblyPath)</HintPath>
        <Private>true</Private>
      </Reference>
    </ItemGroup>
    <PropertyGroup>
      <_CombinedSamplesNotBuilt>@(ProjectReference->WithMetadataValue('BuildReference', 'false')->Count())</_CombinedSamplesNotBuilt>
      <_CombinedSampleTotal>@(ProjectReference->Count())</_CombinedSampleTotal>
    </PropertyGroup>
    <Message Importance="high" Text="Combined build: $(_CombinedSamplesNotBuilt) of $(_CombinedSampleTotal) sample(s) already built and unchanged." Condition="'$(_CombinedSamplesNotBuilt)' != '0'" />
  </Target>
</Project>
